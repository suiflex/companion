{
  "name": "meet-cc-monorepo",
  "private": true,
  "version": "1.7.1",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build -w apps/extension && npm run build -w @meetcc/mcp && npm run build -w @meetcc/sync-server",
    "pack": "node scripts/pack.mjs",
    "pack:source": "node scripts/pack-source.mjs",
    "zip": "npm run build && npm run pack",
    "sign:firefox": "npm run pack -- firefox && web-ext sign --channel=unlisted --source-dir apps/extension/dist-firefox --artifacts-dir web-ext-artifacts",
    "lint:firefox": "npm run pack -- firefox && web-ext lint --source-dir apps/extension/dist-firefox",
    "lint": "eslint .",
    "dev": "npm run dev -w apps/extension",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "web-ext": "^10.6.0"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.49.1-build3"
  }
}
