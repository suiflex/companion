    "class-variance-authority": "0.7.1",
    "lucide-react": "1.59.0",
    "oxc-transform-react": "0.154.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "@fontsource-variable/manrope": "5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
