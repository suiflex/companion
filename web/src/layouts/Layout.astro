---
import '@fontsource-variable/manrope';
import '@/styles/global.css';
import { title, description, links } from '@/data/site';
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const social = Astro.site ? new URL('/social.png', Astro.site) : '/social.png';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Meet Companion',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Windows, macOS, Linux, Chrome, Firefox',
  description,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: links.github,
  downloadUrl: links.releases,
  author: { '@type': 'Organization', name: 'Suiflex', url: links.suiflex },
  ...(canonical ? { url: canonical.href } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafbf8" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo-mark.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meet Companion" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Companion. Your meetings, made useful. Open source. Your AI. Your files."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social} />
    <meta
      name="twitter:image:alt"
      content="Companion. Your meetings, made useful."
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    />
    <script is:inline>
      let theme;
      try {
        theme = localStorage.getItem('companion-web-theme');
      } catch {
        /* System preference works without storage. */
      }
      document.documentElement.dataset.theme =
        theme === 'dark' ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <slot />
    <script>
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      if (!reduceMotion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 },
        );
        document
          .querySelectorAll('[data-reveal]')
          .forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
