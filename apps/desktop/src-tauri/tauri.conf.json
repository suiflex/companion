{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion Desktop",
  "version": "0.2.0",
  "identifier": "dev.suiflex.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Companion Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QzExQjMxMDNENEMwNTYKUldSV3dOUURNUnZCdGl6YkFzRFYvalByNG14MFphTE1uRFRmZ0tRVTgrOEF2VVdzaU5PdS9nc24K",
      "endpoints": [
        "https://github.com/suiflex/companion/releases/download/companion-desktop-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
