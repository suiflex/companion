{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "settings-window",
  "description": "Settings window for desktop preferences, vault and browser integration.",
  "windows": ["settings"],
  "permissions": [
    "core:event:default",
    "core:app:allow-version",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
