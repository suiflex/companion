{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["chrome"],
    "baseUrl": ".",
    "paths": {
      "@meetcc/shared": ["packages/shared/src"],
      "@meetcc/ai": ["packages/ai/src"],
      "@meetcc/meeting": ["packages/meeting/src"],
      "@meetcc/exporters": ["packages/exporters/src"],
      "@meetcc/exporters/*": ["packages/exporters/src/*"]
    }
  },
  "include": ["apps/*/src", "packages/*/src"]
}
